# ========== LLM 配置（任选一个 OpenAI 兼容端点） ==========
# 方式 A：OpenAI 官方
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# 方式 B：Agnes（本项目默认，已验证支持 function calling）
# OPENAI_API_KEY=your-agnes-key
# OPENAI_MODEL=agnes-2.5-flash
# OPENAI_BASE_URL=https://apihub.agnes-ai.com/v1

# 方式 C：SenseNova（备选，已验证支持 function calling）
# OPENAI_API_KEY=your-sensenova-key
# OPENAI_MODEL=sensenova-6.8-flash-lite
# OPENAI_BASE_URL=https://token.sensenova.cn/v1
#
# 说明：本项目需要 LLM 支持 function calling（工具调用），CrewAI 的检索工具依赖此能力。
# 可用 `curl <BASE_URL>/models` 查看端点支持的模型名。
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# ========== 文献数据源（均无需 key，代码自动容错切换） ==========
# 首选 Semantic Scholar；若限流(429)或失败，自动回退 OpenAlex。
# 如有 Semantic Scholar 官方 key，填入可显著提升速率与稳定性：
# SEMANTIC_SCHOLAR_API_KEY=

# ========== Web 检索 ==========
# 默认使用 DuckDuckGo（ddgs，免 key）；如需更稳定的结果，填写 Tavily key
TAVILY_API_KEY=
